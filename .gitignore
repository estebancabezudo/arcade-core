# Compiled binaries, tests and generated browser distribution (contains ROMs)
/build/

# Local commercial ROMs; keep only the directory documentation in version control
/common/roms/*
!/common/roms/README.md
!/common/roms/README.es.md
!/common/roms/CHECKSUMS.txt

# Keep legacy private files ignored until the documented migration is complete
/roms/
/standalone/browser/pacman.js

# External Z80 validation images
*.cim

# Editor, Python and OS metadata
__pycache__/
*.pyc
.idea/
.vscode/
.DS_Store
*~

# Legacy Raspberry Pi local outputs (new outputs are all under /build/)
/standalone/pacman.c
/standalone/platforms/raspberry_pi/build/
/standalone/platforms/raspberry_pi/generated/roms.c
/standalone/platforms/raspberry_pi/roms/
/standalone/platforms/raspberry_pi/examples/*/kernel*.img
